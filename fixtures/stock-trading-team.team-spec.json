    "rubrics": [
      "证据充分性",
      "风险控制完整度",
      "策略假设清晰度",
      "反向证据覆盖度",
      "执行纪律可操作性",
      "免责声明完整度"
    ]
  },
  "templates": [
    {
      "id": "research-brief",
      "path": "research-brief.md",
      "title": "研究简报",
      "sections": [
        "研究目标",
        "标的与周期",
        "数据来源",
        "信息缺口",
