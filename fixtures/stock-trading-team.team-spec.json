      "id": "delivery-summary",
      "path": "delivery-summary.md",
      "title": "研究交付摘要",
      "sections": [
        "结论摘要",
        "证据索引",
        "风险声明",
        "置信度",
        "失效条件",
        "复盘计划"
      ],
      "content": {
        "结论摘要": [
          "用研究辅助语言总结结论，不给确定性买卖指令。",
          "同时说明支持因素和反向因素。"
        ],
        "证据索引": [
          "列出每个关键结论对应的数据、公告、新闻或用户输入来源。",
          "所有来源必须带时间。"
        ],
        "风险声明": [
          "明确不构成投资建议。",
          "列出仓位、止损、流动性和数据缺失风险。"
        ],
        "置信度": [
          "给出高、中、低，并解释不确定性来源。",
          "缺少核心证据时不得标为高。"
        ],
        "失效条件": [
          "列出市场、板块、个股和数据维度的失效条件。",
          "失效后必须重新执行分析流程。"
        ],
        "复盘计划": [
          "写明何时复盘、复盘哪些假设、如何记录偏差。",
          "复盘结果用于更新下一次策略假设。"
        ]
      }
    }
