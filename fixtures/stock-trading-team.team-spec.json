      ],
      "content": {
        "研究目标": [
          "写明用户要解决的问题、研究对象和预期用途。",
          "若目标是直接买卖决策，必须改写为研究辅助目标。"
        ],
        "标的与周期": [
          "记录股票代码、指数、板块或题材名称。",
          "标注短线、中线或长期观察周期。"
        ],
        "数据来源": [
          "列出用户提供数据、公开数据或外部能力来源。",
          "每个来源必须带更新时间。"
        ],
        "信息缺口": [
          "列出缺失的行情、公告、财务或新闻信息。",
          "说明缺口对结论置信度的影响。"
        ],
        "风险边界": [
          "声明不构成投资建议。",
          "记录用户风险偏好、仓位约束和禁止性承诺。"
        ]
      }
    },
    {
      "id": "market-brief",
      "path": "market-brief.md",
      "title": "市场环境简报",
      "sections": [
        "指数环境",
        "板块轮动",
        "题材强度",
        "风险偏好",
        "失效条件"
      ],
      "content": {
        "指数环境": [
          "记录指数趋势、成交额变化和市场风险偏好。",
          "至少列出一条支持证据和一条反向证据。"
        ],
        "板块轮动": [
          "列出强势板块、弱势板块和轮动持续性。",
          "说明龙头扩散或退潮迹象。"
        ],
        "题材强度": [
          "记录题材来源、催化事件和持续性判断。",
          "区分事实、假设和传闻。"
        ],
        "风险偏好": [
          "标注市场处于进攻、防守或观望状态。",
          "说明风险偏好对策略仓位的影响。"
        ],
        "失效条件": [
          "列出指数、板块或题材失效信号。",
          "失效时必须降低置信度或停止交付策略。"
        ]
      }
    },
    {
      "id": "stock-analysis",
      "path": "stock-analysis.md",
      "title": "个股分析",
      "sections": [
        "基本面线索",
        "量价形态",
        "事件催化",
        "反向证据",
        "置信度"
      ],
      "content": {
        "基本面线索": [
          "记录主营、业绩、公告、产业链或政策线索。",
          "缺少可靠来源时只能标为待验证。"
        ],
        "量价形态": [
          "记录趋势方向、成交量变化、关键位置和异常波动。",
          "不得基于单一指标得出确定结论。"
        ],
        "事件催化": [
          "列出公告、新闻、政策、板块事件或市场传闻。",
          "传闻必须标记为未验证。"
        ],
        "反向证据": [
          "列出至少一条看空、失效或冲突信号。",
          "反向证据强时必须降低置信度。"
        ],
        "置信度": [
          "只使用高、中、低。",
          "说明置信度依据和不确定性来源。"
        ]
      }
    },
    {
      "id": "strategy-plan",
      "path": "strategy-plan.md",
      "title": "策略计划",
      "sections": [
