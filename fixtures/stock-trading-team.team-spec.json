        "公告新闻",
        "指标口径",
        "缺失与冲突",
        "结论映射"
      ],
      "content": {
        "行情数据": [
          "记录指数、板块、个股行情来源和更新时间。",
          "无法确认更新时间时必须标为低置信度。"
        ],
        "公告新闻": [
          "列出公告、新闻、政策或产业事件来源。",
          "传闻必须标注为未验证信息。"
        ],
        "指标口径": [
          "说明成交量、涨幅、趋势、关键位置等指标口径。",
          "不得使用未说明口径的指标支撑关键结论。"
        ],
        "缺失与冲突": [
          "列出缺失字段、冲突来源和对结论的影响。",
