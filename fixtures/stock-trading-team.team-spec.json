  "docs": {
    "methodologies": [
      {
        "path": "docs/methodologies/market-research-methodology.md",
        "title": "市场研究方法论",
        "sections": [
          "指数环境",
          "板块轮动",
          "题材强度",
          "失效条件"
        ],
        "content": {
          "指数环境": [
            "先判断上证指数、创业板指和成交额是否支持风险偏好扩张。",
            "必须区分趋势判断、震荡判断和极端风险，不用单日涨跌替代环境结论。",
            "输出至少一条支持证据和一条反向证据。"
          ],
          "板块轮动": [
            "按涨幅、成交额、持续天数和龙头扩散情况识别强弱板块。",
            "必须说明板块强度来自事实数据还是题材假设。",
            "若板块轮动过快或无持续性，需要降低策略置信度。"
          ],
          "题材强度": [
            "题材判断必须关联政策、公告、产业事件或资金行为中的至少一种来源。",
            "区分首发催化、持续发酵和兑现退潮三类阶段。",
            "不得把未经验证的传闻当作确定事实。"
          ],
          "失效条件": [
            "指数放量下跌、板块龙头破位、题材证据被证伪时，必须标记环境失效。",
            "数据超过一个交易日未更新时，必须降低置信度或暂停结论。",
            "无法获得来源和时间的行情或新闻不得作为关键证据。"
          ]
        }
      },
      {
        "path": "docs/methodologies/strategy-methodology.md",
        "title": "策略方法论",
        "sections": [
          "策略假设",
          "触发条件",
          "执行纪律",
          "复盘"
        ],
        "content": {
          "策略假设": [
            "策略必须写明适用行情、目标周期、核心证据和反向证据。",
            "每个策略只能表达观察框架，不得表达确定性买入、卖出或收益承诺。",
            "若市场环境、板块强度和个股信号不一致，策略置信度不得标为高。"
          ],
          "触发条件": [
            "触发条件必须包含价格/量能/位置/事件四类信息中的至少两类。",
            "触发条件只能作为观察条件，不得输出替用户下单的确定指令。",
            "缺少数据来源或更新时间时，触发条件必须判为未满足。"
          ],
          "执行纪律": [
            "必须声明仓位上限、止损条件、暂停条件和复盘节点。",
            "遇到计划外追涨、加杠杆、满仓等行为，执行教练必须触发纪律提醒。",
            "风险经理结论与策略负责人冲突时，以风险阻断为准。"
          ],
          "复盘": [
            "复盘至少记录假设是否成立、证据是否失效、风险是否低估。",
            "必须区分过程正确但结果随机、过程错误但结果盈利两类情况。",
            "下一次策略迭代必须引用本次复盘结论。"
          ]
        }
      }
    ],
    "standards": [
      {
        "path": "docs/engineering-standards/evidence-standard.md",
        "title": "证据标准",
        "sections": [
          "数据来源",
          "数据时效",
          "置信度",
          "反向证据"
        ],
        "content": {
          "数据来源": [
            "行情、公告、新闻、指标和用户输入必须分别标注来源。",
            "无法验证来源的数据只能作为背景信息，不能作为核心结论依据。",
            "不得编造行情价格、成交量、公告或新闻。"
          ],
          "数据时效": [
            "行情数据必须标注交易日和更新时间。",
            "新闻或公告必须标注发布日期，过期信息需要说明是否仍有效。",
            "数据超过用户目标周期可接受范围时，必须触发数据质量风险。"
          ],
          "置信度": [
            "置信度只允许高、中、低，并必须说明不确定性来源。",
            "缺少反向证据或数据源时，置信度不得为高。",
            "高风险输出必须同时包含失效条件。"
          ],
          "反向证据": [
            "每个核心结论必须列出至少一条可能推翻结论的证据。",
            "反向证据强于正向证据时，必须降低策略等级或阻断交付。",
            "不能只选择支持既有判断的数据。"
          ]
        }
      }
    ],
    "integrations": [
      {
        "path": "docs/integrations/market-data-contract.md",
        "title": "行情数据契约",
        "sections": [
          "数据来源",
          "更新时间",
          "缺失处理",
          "安全边界"
        ],
        "content": {
          "数据来源": [
            "支持用户提供数据、公开行情、公告、新闻和经授权的外部金融数据能力。",
            "每个数据源都必须记录来源名称、获取方式和适用角色。",
            "未授权外部能力不得被描述为已调用。"
          ],
          "更新时间": [
            "行情数据默认要求交易日内或最近一个交易日。",
            "事件和公告数据必须记录发布时间。",
            "无法确认更新时间时，必须写入信息缺口。"
          ],
          "缺失处理": [
            "关键字段缺失时输出“无法完成该判断”，不得用猜测补齐。",
            "非关键字段缺失时可以继续分析，但必须在证据索引中标注影响。",
            "数据冲突时必须同时列出冲突来源并降低置信度。"
          ],
          "安全边界": [
            "不得保存密钥、Cookie、Token 或个人账户信息。",
            "不得绕过用户授权安装或调用外部金融数据工具。",
            "不得输出替代持牌投顾服务的承诺。"
          ]
        }
      }
    ],
    "qualityGates": [
      "intake-gate",
      "role-activation-gate",
      "value-gate",
      "decision-gate",
      "handoff-gate",
      "complexity-gate",
