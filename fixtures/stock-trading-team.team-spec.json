        "适用行情",
        "触发条件",
        "失效条件",
        "复盘计划"
      ],
      "content": {
        "策略假设": [
          "写明策略成立所依赖的市场、板块和个股证据。",
          "必须包含至少一条反向证据。"
        ],
        "适用行情": [
          "说明适用于趋势、震荡、反弹或防守中的哪类环境。",
          "市场环境不匹配时不得输出策略计划。"
        ],
        "触发条件": [
          "描述观察条件，不输出确定性买卖指令。",
          "触发条件必须可被数据或事件验证。"
        ],
        "失效条件": [
          "列出价格、量能、事件或风险条件中的失效信号。",
          "失效时必须停止沿用原策略。"
        ],
        "复盘计划": [
          "记录复盘时间、复盘指标和需要验证的假设。",
          "复盘必须比较原假设与实际变化。"
        ]
      }
    },
    {
      "id": "risk-register",
      "path": "risk-register.md",
      "title": "风险台账",
      "sections": [
        "仓位风险",
        "止损条件",
        "回撤风险",
        "流动性风险",
        "禁止性承诺检查"
      ],
      "content": {
        "仓位风险": [
          "记录假设仓位上限和不适合加仓的条件。",
          "不得建议满仓或加杠杆。"
        ],
        "止损条件": [
          "写明策略失效、数据失效和风险偏好失效条件。",
          "止损条件必须先于策略交付给出。"
        ],
        "回撤风险": [
          "说明可能导致亏损扩大的场景。",
          "高波动标的必须提示回撤不确定性。"
        ],
        "流动性风险": [
          "记录成交额、封单、跌停或停牌等流动性风险。",
