{
  "schemaVersion": "2.0.0",
  "skill": {
    "id": "stock-trading-team",
    "name": "A Stock Trading Research Team Skill",
    "description": "A-share market research, strategy review, risk control, and trading-plan workflow skill.",
    "version": "0.1.0",
    "domain": "A 股投资研究与交易计划辅助",
    "targetUsers": [
      "需要结构化分析 A 股市场和个股的 Agent 用户",
      "需要风险控制和交易复盘框架的个人研究者"
    ],
    "primaryValue": "把市场环境、板块题材、个股量价、策略假设、仓位风险和复盘纪律沉淀为可验证的研究流程。"
  },
  "readme": {
    "english": {
      "name": "A-Share Stock Trading Research Team",
      "description": "An expert-team Skill for A-share market research, strategy review, risk control, and trading-plan workflows.",
      "domain": "A-share investment research and trading-plan assistance",
      "primaryValue": "Turn market conditions, sector themes, stock price-volume behavior, strategy hypotheses, position risk, and review discipline into a verifiable research workflow.",
      "targetUsers": [
        "Agent users who need structured analysis of China's A-share market and individual stocks.",
        "Individual researchers who need a risk-control and trading review framework."
      ],
      "riskDisclaimers": [
        "This team's output is for research and educational assistance only and does not constitute investment advice.",
        "This team does not replace advice from a licensed investment adviser; users remain solely responsible for their investment decisions and risks.",
        "Every analysis must state its data sources, data freshness, position risks, and invalidation conditions."
      ],
      "blockedClaims": [
        "Do not promise returns.",
        "Do not issue deterministic buy or sell instructions.",
        "Do not guarantee price increases, limit-up moves, recovery of losses, or profits."
      ]
    }
  },
  "teamDesign": {
    "problemStatement": "个人研究者需要把 A 股市场、板块、个股、策略与风险判断组织为可追踪、可复核的研究流程。",
    "mission": "提供研究辅助团队，先证据、后策略、先风险、后交付，不替代用户或持牌投顾承担投资决策。",
    "targetOutcomes": [
      "市场、板块和个股判断均有来源、时效、反向证据和置信度。",
      "策略计划包含触发、失效、仓位、止损和复盘条件。",
      "禁止性承诺和缺失证据在交付前被风险角色阻断。"
    ],
    "stakeholders": [
      "个人研究者",
      "使用该 Skill 的 Agent 用户",
      "最终投资决策和风险责任人"
    ],
    "constraints": [
      "不构成投资建议，不替代持牌投顾。",
      "不承诺收益，不代替用户下单。",
      "行情、公告、新闻和指标必须有来源与时间。"
    ],
    "nonGoals": [
      "不输出确定性买卖指令。",
      "不执行交易或管理真实资金。"
    ],
    "assumptions": [
      "用户会提供标的、周期和风险偏好。",
      "外部金融数据能力只有在授权后才可使用。"
    ],
    "valueMetrics": [
      {
        "name": "研究结论证据覆盖率",
        "baseline": "待首轮真实研究采集",
        "target": "每个核心结论均映射来源、时效、反证和失效条件",
        "evidenceSource": "evidence-index、研究报告和人工复核记录",
        "reviewCadence": "每次研究交付后"
      },
      {
        "name": "高风险承诺误放行率",
        "baseline": "0",
        "target": "持续为 0",
        "evidenceSource": "risk gate 和 acceptance runner",
        "reviewCadence": "每次发布"
      }
    ]
  },
  "governance": {
    "defaultComplexityLevel": "L",
    "defaultExecutionProfile": "assurance",
    "targetVerificationLevel": "V3",
    "roleModes": [
      "active",
      "consulted",
      "not_applicable"
    ],
    "reassessmentTriggers": [
      "研究范围、时间周期、风险偏好或数据来源变化。",
      "数据冲突、验证失败、外部能力不可用或出现确定性交易诉求。"
    ],
    "requiredGates": [
      "role-activation-gate",
      "value-gate",
      "decision-gate",
      "handoff-gate",
      "complexity-gate",
      "evidence-gate",
      "verification-gate",
      "disclaimer-gate",
      "delivery-gate"
    ],
    "humanReview": {
      "required": true,
      "accountableRole": "risk-manager",
      "requiredWhen": [
        "策略计划涉及真实仓位、止损或用户准备采取行动。",
        "数据缺失、冲突或输出接近确定性投资建议。"
      ],
      "blockedWithoutApproval": true
    }
  },
  "commands": {
    "prefix": "/stock-team",
    "items": [
      {
        "name": "intake",
        "workflow": "research-intake",
        "description": "梳理研究目标、标的、周期、风险偏好和数据来源。",
        "requiredInput": "研究目标、标的或市场问题",
        "defaultOutput": "研究简报和信息缺口"
      },
      {
        "name": "analyze",
        "workflow": "market-stock-analysis",
        "description": "分析指数环境、板块轮动、题材和个股量价。",
        "requiredInput": "指数、板块、个股或题材上下文",
        "defaultOutput": "市场与个股分析报告"
      },
      {
        "name": "strategy",
        "workflow": "strategy-plan",
        "description": "形成策略假设、适用场景、触发条件和失效条件。",
        "requiredInput": "分析结论和风险偏好",
        "defaultOutput": "策略计划和执行检查表"
      },
      {
        "name": "risk",
        "workflow": "risk-control",
        "description": "评估仓位、止损、回撤、流动性和黑名单风险。",
        "requiredInput": "标的、仓位假设、策略计划",
        "defaultOutput": "风险评估和风控建议"
      },
      {
        "name": "review",
        "workflow": "strategy-review",
        "description": "复核证据、置信度、冲突信号和禁止性承诺。",
        "requiredInput": "分析报告、策略计划、风险评估",
        "defaultOutput": "策略复核结论"
      },
      {
        "name": "deliver",
        "workflow": "research-delivery",
        "description": "汇总研究结论、证据、风险、失效条件和复盘计划。",
        "requiredInput": "研究上下文",
        "defaultOutput": "研究交付摘要"
      }
    ]
  },
