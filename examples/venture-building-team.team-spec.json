        "不在证据不足时做不可逆投入。"
      ],
      "activation": {
        "activeWhen": [
          "涉及使命、定位、优先级、资金或跨角色裁决。"
        ],
        "consultedWhen": [
          "单一实验只需确认目标和决策边界。"
        ],
        "notApplicableWhen": [
          "不适用；可委托阶段执行，但最终责任不能移除。"
        ],
        "reassessWhen": [
          "核心假设、预算、目标客户或外部风险变化。"
        ]
      },
      "externalSkills": []
    },
    {
      "id": "customer-research-lead",
      "name": "客户研究负责人",
