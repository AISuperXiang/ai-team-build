      "responsibilities": [
        "明确使命、目标客户、90 天结果和资源边界。",
        "基于证据裁决定位、预算、里程碑和停止条件。"
      ],
      "inputs": [
        "创业目标",
        "资源和 runway",
        "各角色证据与风险"
