{
  "schemaVersion": "2.0.0",
  "skill": {
    "id": "venture-building-team",
    "name": "Venture Building Team Skill",
    "description": "Customer discovery, offer design, go-to-market, runway, operations, and founder decision workflow skill.",
    "version": "0.1.0",
    "domain": "从零创业与企业构建",
    "targetUsers": [
      "需要从问题机会开始搭建业务的创业者",
      "需要用小团队验证市场、方案和增长路径的业务负责人"
    ],
    "primaryValue": "把创业想法推进为有客户证据、有最小方案、有获客路径、有现金流边界和阶段复盘的可执行企业构建计划。"
  },
  "teamDesign": {
    "problemStatement": "从零创业者通常同时缺少客户证据、清晰定位、可销售方案、获客路径、现金流纪律和交付节奏。",
    "mission": "在 90 天内用最小充分团队验证真实问题、形成可销售方案、建立首个 GTM 闭环，并控制现金流与不可逆风险。",
    "targetOutcomes": [
      "形成有证据的问题定义、目标客户和价值主张。",
      "完成最小可销售方案与定价假设。",
      "建立首批获客、转化、交付和复购实验。",
      "形成 runway、合规、关键决策和 30/60/90 天复盘机制。"
    ],
    "stakeholders": [
      "创始人和联合创始人",
      "目标客户与早期采用者",
      "资金、法务和交付责任人"
    ],
    "constraints": [
      "优先验证高风险假设，不用大规模投入替代客户证据。",
      "资金、合同、招聘、隐私和监管事项由人类责任人最终批准。",
      "未获授权前不执行付款、签约、招聘或外部发布。"
    ],
    "nonGoals": [
      "不承诺 90 天内融资、盈利或实现产品市场匹配。",
      "不一次性搭建完整公司编制。",
      "不替代律师、会计师、投资顾问或雇佣责任人。"
    ],
    "assumptions": [
      "创始人能够接触潜在客户并记录访谈证据。",
      "首轮目标是学习速度和可重复证据，不是虚荣指标。",
      "团队会按角色激活计划只投入当前里程碑需要的能力。"
    ],
    "valueMetrics": [
      {
        "name": "问题证据强度",
        "baseline": "待完成首轮客户访谈",
        "target": "至少 10 个目标客户样本，重复痛点和付费信号可追踪",
        "evidenceSource": "客户访谈记录、行为数据、预付或意向证据",
        "reviewCadence": "每周"
      },
      {
        "name": "验证学习周期",
        "baseline": "待采集",
        "target": "每两周至少关闭一个最高风险假设",
        "evidenceSource": "hypothesis log、experiment report、decision log",
        "reviewCadence": "双周"
      },
      {
        "name": "现金 runway",
        "baseline": "由创始人提供真实预算",
        "target": "关键实验不突破经批准的现金与时间上限",
        "evidenceSource": "预算、现金流和支出审批记录",
        "reviewCadence": "每月"
      }
    ]
  },
  "governance": {
    "defaultComplexityLevel": "L",
    "defaultExecutionProfile": "assurance",
    "targetVerificationLevel": "V3",
    "roleModes": [
      "active",
      "consulted",
      "not_applicable"
    ],
    "reassessmentTriggers": [
      "目标客户、问题、方案、定价或渠道假设被证伪。",
      "出现资金、合同、招聘、隐私、监管或不可逆承诺。",
      "验证失败、runway 下降或里程碑范围扩大。"
    ],
    "requiredGates": [
      "role-activation-gate",
      "value-gate",
      "decision-gate",
      "handoff-gate",
      "complexity-gate",
      "evidence-gate",
      "verification-gate",
      "runway-gate",
      "delivery-gate"
    ],
    "humanReview": {
      "required": true,
      "accountableRole": "founder-strategist",
      "requiredWhen": [
        "涉及资金、合同、招聘、股权、隐私或对外承诺。",
        "需要改变目标客户、核心定位或预算上限。"
      ],
      "blockedWithoutApproval": true
    }
  },
  "commands": {
    "prefix": "/venture-team",
    "items": [
      {
        "name": "intake",
        "workflow": "venture-intake",
        "description": "明确创业目标、约束、runway、关键假设和 90 天结果。",
        "requiredInput": "创业想法、资源、时限和成功标准",
        "defaultOutput": "venture brief、假设清单和里程碑"
      },
      {
        "name": "discover",
        "workflow": "customer-validation",
        "description": "设计并复核客户发现、问题验证和付费信号。",
        "requiredInput": "目标客户假设和问题假设",
        "defaultOutput": "客户证据、问题排序和决策建议"
      },
      {
        "name": "offer",
        "workflow": "offer-validation",
        "description": "形成最小可销售方案、定价和交付实验。",
        "requiredInput": "客户证据和价值假设",
        "defaultOutput": "offer、实验计划和交付约束"
      },
      {
        "name": "gtm",
        "workflow": "go-to-market-validation",
        "description": "设计渠道、信息、销售和转化实验。",
        "requiredInput": "目标客户、offer 和预算",
        "defaultOutput": "GTM 实验、指标和停止条件"
      },
      {
        "name": "operate",
        "workflow": "operating-review",
        "description": "复核现金流、交付能力、风险和 30/60/90 天计划。",
        "requiredInput": "实验结果、预算、交付与风险数据",
        "defaultOutput": "经营复盘和下一阶段资源计划"
      },
      {
        "name": "deliver",
        "workflow": "venture-delivery",
        "description": "汇总证据、决策、风险、runway 和下一轮计划。",
        "requiredInput": "当前里程碑产物和验证记录",
        "defaultOutput": "venture delivery summary"
      }
    ]
  },
  "members": [
    {
      "id": "founder-strategist",
      "name": "创始人战略负责人",
      "role": "strategy",
      "when_to_load": [
