  "docs": {
    "methodologies": [
      {
        "path": "docs/methodologies/evidence-based-venture-methodology.md",
        "title": "证据驱动创业方法论",
        "sections": [
          "假设排序",
          "客户证据",
          "最小实验",
          "阶段决策"
        ],
        "content": {
          "假设排序": [
            "按影响、未知度、验证成本和不可逆性排序。",
            "每个里程碑只保留少量最高风险假设。"
          ],
          "客户证据": [
            "区分用户意见、真实行为、付费意向和已付费证据。",
            "记录样本、来源、时间、反向证据和偏差。"
          ],
          "最小实验": [
            "用最小时间和现金验证一个明确假设。",
            "实验开始前定义成功、失败和停止阈值。"
          ],
          "阶段决策": [
            "继续、聚焦、转向或停止必须引用证据和 runway。",
            "高影响决策写入 decision log 并设定复盘日期。"
          ]
        }
      }
    ],
    "standards": [
      {
        "path": "docs/engineering-standards/venture-evidence-standard.md",
        "title": "创业证据与决策标准",
        "sections": [
          "证据等级",
          "指标纪律",
          "资金与承诺",
          "失败处理"
        ],
        "content": {
          "证据等级": [
            "观点弱于行为，行为弱于付费和重复使用。",
            "未经来源和时间标记的材料不能支撑高影响决策。"
          ],
          "指标纪律": [
            "指标必须关联价值假设、基线、目标、周期和数据来源。",
            "曝光、注册等虚荣指标不能替代付费、留存或效率证据。"
          ],
          "资金与承诺": [
            "每个实验声明现金、时间和责任上限。",
            "合同、招聘、股权和大额支出必须人工批准。"
          ],
          "失败处理": [
            "失败实验保留事实、原因、不确定性和下一步。",
            "不得通过修改成功标准掩盖失败。"
          ]
        }
      }
    ],
    "integrations": [
      {
        "path": "docs/integrations/venture-data-contract.md",
        "title": "创业输入与指标契约",
        "sections": [
          "客户材料",
          "财务材料",
          "外部数据",
          "缺失处理"
        ],
        "content": {
          "客户材料": [
            "访谈、行为和付费证据必须记录样本、来源、时间和上下文。",
            "敏感客户数据必须最小化并获得授权。"
          ],
          "财务材料": [
            "预算、现金流和 runway 必须由创始人确认口径。",
            "未经确认的财务数字只能作为待验证假设。"
          ],
          "外部数据": [
            "市场报告、竞品和渠道数据必须记录来源、日期和适用范围。",
            "不得把公开估算写成公司已验证事实。"
          ],
          "缺失处理": [
            "关键证据缺失时停止对应决策或降低验证等级。",
            "无法获得专业意见时保留人工复核阻塞。"
          ]
        }
      }
    ],
