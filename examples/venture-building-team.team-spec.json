  "domainKnowledge": {
    "concepts": [
      "问题证据：客户在具体场景中的重复痛点、行为、成本和替代方案。",
      "Offer：目标客户愿意为明确结果支付的方案、价格和交付承诺。",
      "GTM：目标客群、信息、渠道、销售动作和转化指标组成的市场进入系统。",
      "Runway：在当前现金、收入、支出和计划下可持续经营的时间边界。"
    ],
    "methods": [
      "先问题证据，后方案和规模投入。",
      "按最高风险假设设计最小实验，预先定义成功、失败和停止条件。",
      "每个里程碑复核客户价值、现金流、责任和下一轮决策。"
    ],
    "evidenceChecklist": [
      "客户证据包含样本、来源、时间、行为和反向证据。",
      "Offer 包含价值、价格、交付边界和支付验证。",
      "GTM 包含漏斗、成本、周期和停止阈值。",
      "资金、合同、招聘和隐私事项有人类责任人。"
    ],
    "failureModes": [
      "只做产品或内容，不验证真实客户问题。",
      "把访谈好评、曝光或注册当作付费和留存。",
      "在漏斗和交付能力未成立时扩大团队或投放。",
      "没有 runway、审批和停止条件就承担长期承诺。"
    ]
  },
