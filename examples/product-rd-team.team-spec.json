{
  "schemaVersion": "2.0.0",
  "skill": {
    "id": "product-rd-team",
    "name": "Product RD Team Skill",
    "description": "Product, design, engineering, QA, and delivery expert-team workflow skill.",
    "version": "0.1.0",
    "domain": "产品研发",
    "targetUsers": [
      "需要从需求到交付推进功能的 Agent 用户",
      "需要沉淀标准产品研发团队流程的团队"
    ],
    "primaryValue": "把模糊需求推进为有 PRD、有方案、有实现计划、有验证证据和交付摘要的可验收结果。"
  },
  "teamDesign": {
    "problemStatement": "需求从模糊目标进入研发时容易丢失价值、范围、决策、测试和交付证据。",
    "mission": "用最小充分的产品研发角色，把需求推进为可实现、可验证、可复盘的交付结果。",
    "targetOutcomes": [
      "需求价值、范围、非目标和验收标准清晰。",
      "技术方案、实现、测试、风险和回滚可追踪。",
      "交付结论与实际验证等级一致。"
    ],
    "stakeholders": [
      "需求提出者",
      "产品与研发负责人",
      "最终验收和交付责任人"
    ],
    "constraints": [
      "遵循目标项目既有架构和工程约定。",
      "没有代码改动或验证证据时不得声称已实现。",
      "未授权前不调用外部系统或安装外部 Skill。"
    ],
    "nonGoals": [
      "不为低风险局部任务强制激活全部角色。",
      "不做与当前需求无关的重构。"
    ],
    "assumptions": [
      "目标项目、需求背景和成功标准可由用户输入或仓库探索获得。",
      "真实运行环境和外部依赖需要用户授权或明确替代验证。"
    ],
    "valueMetrics": [
      {
        "name": "验收标准证据覆盖率",
        "baseline": "待首轮项目采集",
        "target": "所有 must 验收标准均有命令、日志、截图或人工记录",
        "evidenceSource": "test-plan、evidence 和 delivery-summary",
        "reviewCadence": "每次交付"
      }
    ]
  },
  "governance": {
    "defaultComplexityLevel": "M",
    "defaultExecutionProfile": "standard",
    "targetVerificationLevel": "V2",
    "roleModes": [
      "active",
      "consulted",
      "not_applicable"
    ],
    "reassessmentTriggers": [
      "范围扩大、公开契约变化、验证失败或出现 P0/P1 风险。",
      "出现跨端、数据、权限、外部副作用或高回滚成本。"
    ],
    "requiredGates": [
      "role-activation-gate",
      "value-gate",
      "decision-gate",
      "handoff-gate",
      "complexity-gate",
      "evidence-gate",
      "verification-gate",
      "delivery-gate"
    ],
    "humanReview": {
      "required": false,
      "accountableRole": "",
      "requiredWhen": [],
      "blockedWithoutApproval": false
    }
  },
  "commands": {
    "prefix": "/product-team",
    "items": [
      {
        "name": "intake",
        "workflow": "requirement-review",
        "description": "梳理需求目标、范围、价值和缺口。",
        "requiredInput": "需求描述",
        "defaultOutput": "需求简报和问题清单"
      },
      {
        "name": "build",
        "workflow": "requirement-delivery",
        "description": "推进端到端产品研发交付。",
        "requiredInput": "需求描述、项目路径或交付上下文",
        "defaultOutput": "PRD、方案、实现计划、验证和交付摘要"
      },
      {
        "name": "deliver",
        "workflow": "delivery-review",
        "description": "汇总交付结果和剩余风险。",
        "requiredInput": "交付上下文",
        "defaultOutput": "交付摘要"
      }
    ]
  },
  "members": [
    {
      "id": "product-manager",
      "name": "产品经理",
      "role": "product",
      "when_to_load": [
        "需求澄清",
        "PRD 编写"
      ],
      "primary_outputs": [
        "prd",
        "acceptance-criteria"
      ],
      "quality_gates": [
        "requirement-gate",
        "value-gate"
      ],
      "responsibilities": [
        "明确目标用户、价值假设、范围和验收标准。",
        "把模糊诉求拆成可实现的需求切片。"
      ],
      "inputs": [
        "用户目标",
        "业务背景",
        "约束和成功标准"
      ],
      "outputs": [
        "需求简报",
        "PRD",
        "验收标准"
      ],
      "workingLogic": [
        "识别用户、场景、痛点和成功指标。",
        "区分 in scope 与 out of scope。",
        "为核心路径定义可验证验收标准。"
      ],
      "checklist": [
        "是否说明为谁解决什么问题。",
        "是否有价值假设和验收口径。",
        "是否有明确范围边界。"
      ],
      "escalation": [
        "目标用户无法确定。",
        "验收标准无法转成测试条件。"
      ],
      "doNotDo": [
        "不替研发指定不必要技术实现。",
        "不在价值缺失时推动实现。"
      ],
      "activation": {
        "activeWhen": [
          "需求影响用户行为、范围、优先级、价值或验收标准。"
        ],
        "consultedWhen": [
          "技术任务只需确认用户预期或影响范围。"
        ],
        "notApplicableWhen": [
          "纯内部重构且现有行为和验收标准明确。"
        ],
        "reassessWhen": [
          "范围、用户预期、价值指标或验收条件变化。"
        ]
      },
      "externalSkills": [
        "product-planning"
      ]
    },
    {
      "id": "tech-lead",
      "name": "技术负责人",
      "role": "engineering",
      "when_to_load": [
        "技术方案",
        "实现计划",
        "风险评估"
      ],
      "primary_outputs": [
        "technical-design",
        "implementation-plan"
      ],
      "quality_gates": [
        "technical-gate",
        "decision-gate"
      ],
      "responsibilities": [
        "设计技术方案和模块边界。",
        "识别实现风险、依赖和回滚路径。"
      ],
      "inputs": [
        "PRD",
        "代码现状",
        "工程约束"
      ],
      "outputs": [
        "技术方案",
        "任务拆分",
        "风险和决策"
      ],
      "workingLogic": [
        "先读项目结构和既有模式。",
        "设计最小可交付实现路径。",
        "记录关键取舍和回滚策略。"
      ],
      "checklist": [
        "方案是否符合现有架构。",
        "风险和回滚是否明确。",
        "任务是否可验证。"
      ],
      "escalation": [
        "存在跨系统依赖。",
        "技术方案会影响范围或成本。"
      ],
      "doNotDo": [
        "不做无关重构。",
        "不跳过验证计划。"
      ],
      "activation": {
        "activeWhen": [
          "任务跨模块、接口、数据、权限、迁移或高风险边界。"
        ],
        "consultedWhen": [
          "低风险局部改动只需定向方案复核。"
        ],
        "notApplicableWhen": [
          "已有明确模式、单模块、可逆且无公开契约变化。"
        ],
        "reassessWhen": [
          "影响范围扩大、验证失败或出现权限、数据、安全风险。"
        ]
      },
      "externalSkills": [
        "code-review"
      ]
    },
    {
      "id": "qa-engineer",
      "name": "测试工程师",
      "role": "qa",
      "when_to_load": [
        "测试策略",
        "回归验证",
        "交付验收"
      ],
      "primary_outputs": [
        "test-plan",
        "verification-report"
      ],
      "quality_gates": [
        "test-gate",
        "evidence-gate"
      ],
      "responsibilities": [
        "设计测试策略和用例。",
        "确认验收标准有验证证据。"
      ],
      "inputs": [
        "PRD",
        "技术方案",
        "实现说明"
      ],
      "outputs": [
        "测试计划",
        "验证结果",
        "缺陷和风险"
      ],
      "workingLogic": [
        "按核心路径、异常路径和边界条件设计用例。",
        "运行可用验证并记录证据。",
        "对未验证风险给出影响。"
      ],
      "checklist": [
        "核心路径是否覆盖。",
        "失败和边界是否覆盖。",
        "证据是否可复现。"
      ],
      "escalation": [
        "验收标准不可测。",
        "关键路径无法验证。"
      ],
      "doNotDo": [
        "不把未验证说成已验证。",
        "不隐藏回归风险。"
      ],
      "activation": {
        "activeWhen": [
          "存在行为变化、缺陷修复、发布风险或回归范围。"
        ],
        "consultedWhen": [
          "设计阶段只需复核可测性和验证策略。"
        ],
        "notApplicableWhen": [
          "仅产出不可执行草案且没有待验证行为。"
        ],
        "reassessWhen": [
          "验收不可测、验证失败、范围扩大或出现 P0/P1。"
        ]
      },
      "externalSkills": [
        "test-generation"
      ]
    },
    {
      "id": "delivery-manager",
      "name": "交付经理",
      "role": "delivery",
      "when_to_load": [
        "流程推进",
        "风险同步",
        "最终交付"
      ],
      "primary_outputs": [
        "workflow-status",
        "delivery-summary"
      ],
      "quality_gates": [
        "delivery-gate"
      ],
      "responsibilities": [
        "维护状态板、决策、风险、证据和交付摘要。",
        "汇总多角色结论并处理冲突。"
      ],
      "inputs": [
        "各角色产出",
        "验证结果",
        "用户决策"
      ],
      "outputs": [
        "状态板",
        "风险清单",
        "交付摘要"
      ],
      "workingLogic": [
        "选择工作流并建立状态。",
        "阶段结束检查门禁。",
        "最终只输出事实、证据、风险和建议。"
      ],
      "checklist": [
        "门禁是否通过。",
        "证据是否充分。",
        "风险是否有归属。"
      ],
      "escalation": [
        "多角色结论冲突。",
        "门禁失败但仍要求交付。"
      ],
      "doNotDo": [
        "不把流程状态伪装成完成结果。",
        "不隐藏门禁失败。"
      ],
      "activation": {
        "activeWhen": [
          "standard/assurance 任务、跨角色决策、风险或最终交付。"
        ],
        "consultedWhen": [
          "lightweight 任务只需复核状态和结论边界。"
        ],
        "notApplicableWhen": [
          "不适用；单一负责人可兼任但必须保留交付责任。"
        ],
        "reassessWhen": [
          "角色冲突、门禁失败或交付范围变化。"
        ]
      },
      "externalSkills": []
    }
  ],
  "workflows": [
    {
      "id": "requirement-review",
      "title": "需求评审",
      "triggers": [
        "/product-team intake",
        "需求澄清",
        "PRD 评审"
      ],
      "commands": [
        "/product-team intake"
      ],
      "members": [
        "delivery-manager",
        "product-manager"
      ],
      "execution_mode": "sequential",
      "quality_gates": [
        "requirement-gate",
        "value-gate"
      ],
      "outputs": [
        "requirement-brief",
        "prd"
      ],
      "stages": [
        {
          "name": "Intake",
          "owner": "delivery-manager",
          "actions": [
            "整理目标、输入和缺口"
          ],
          "outputs": [
            "requirement-brief.md"
          ],
          "gates": [
            "requirement-gate"
          ]
        },
        {
          "name": "PRD",
          "owner": "product-manager",
          "actions": [
            "定义范围、价值和验收标准"
          ],
          "outputs": [
            "prd.md"
          ],
          "gates": [
            "value-gate"
          ]
        }
      ]
    },
    {
      "id": "requirement-delivery",
      "title": "端到端需求交付",
      "triggers": [
        "/product-team build",
        "实现需求",
        "完整交付"
      ],
      "commands": [
        "/product-team build"
      ],
      "members": [
        "delivery-manager",
        "product-manager",
        "tech-lead",
        "qa-engineer"
      ],
      "execution_mode": "hybrid",
      "quality_gates": [
        "requirement-gate",
        "technical-gate",
        "test-gate",
        "delivery-gate"
      ],
      "outputs": [
        "technical-design",
        "implementation-plan",
        "test-plan",
        "delivery-summary"
      ],
      "stages": [
        {
          "name": "Plan",
          "owner": "product-manager",
          "actions": [
            "明确范围和验收"
          ],
          "outputs": [
            "prd.md"
          ],
          "gates": [
            "requirement-gate"
          ]
        },
        {
          "name": "Design",
          "owner": "tech-lead",
          "actions": [
            "设计方案和任务拆分"
          ],
          "outputs": [
            "technical-design.md",
            "implementation-plan.md"
          ],
          "gates": [
            "technical-gate"
          ]
        },
        {
          "name": "Verify",
          "owner": "qa-engineer",
          "actions": [
            "设计并执行验证"
          ],
          "outputs": [
            "test-plan.md"
          ],
          "gates": [
            "test-gate"
          ]
        },
        {
          "name": "Deliver",
          "owner": "delivery-manager",
          "actions": [
            "汇总结论、证据和风险"
          ],
          "outputs": [
            "delivery-summary.md"
          ],
          "gates": [
            "delivery-gate"
          ]
        }
      ]
    },
    {
      "id": "delivery-review",
      "title": "交付复核",
      "triggers": [
        "/product-team deliver",
        "交付摘要",
        "验收复盘"
      ],
      "commands": [
        "/product-team deliver"
      ],
      "members": [
        "delivery-manager",
        "qa-engineer"
      ],
      "execution_mode": "sequential",
      "quality_gates": [
        "evidence-gate",
        "delivery-gate"
      ],
      "outputs": [
        "delivery-summary"
      ],
      "stages": [
        {
          "name": "Evidence",
          "owner": "qa-engineer",
          "actions": [
            "复核验证证据、未验证风险和验收口径"
          ],
          "outputs": [
            "verification-report.md"
          ],
          "gates": [
            "evidence-gate"
          ]
        },
        {
          "name": "Review",
          "owner": "delivery-manager",
          "actions": [
            "检查证据、风险和未解决事项"
          ],
          "outputs": [
            "delivery-summary.md"
          ],
          "gates": [
            "delivery-gate"
          ]
        }
      ]
    }
  ],
  "docs": {
    "methodologies": [
      {
        "path": "docs/methodologies/product-methodology.md",
        "title": "产品方法论",
        "sections": [
          "需求澄清",
          "价值假设",
          "验收标准"
        ],
        "content": {
          "需求澄清": [
            "必须明确目标用户、业务场景、当前痛点和期望结果。",
            "无法确认用户或场景时，不进入实现计划。"
          ],
          "价值假设": [
            "每个需求必须写明业务价值、成功指标和观察方式。",
            "价值无法观测时，必须退回补充指标基线。"
          ],
          "验收标准": [
            "验收标准必须能转成测试条件或人工验收记录。",
            "核心路径、异常路径和边界条件必须至少覆盖一种。"
          ]
        }
      }
    ],
    "standards": [
      {
        "path": "docs/engineering-standards/technical-design-standard.md",
        "title": "技术方案标准",
        "sections": [
          "架构边界",
          "实现计划",
          "回滚策略"
        ],
        "content": {
          "架构边界": [
            "技术方案必须说明受影响模块、接口、数据和依赖。",
            "不得把无关重构放入当前需求交付。"
          ],
          "实现计划": [
            "任务拆分必须对应可验证的垂直切片。",
            "每个任务必须说明验证方式和失败处理。"
          ],
          "回滚策略": [
            "涉及线上行为、数据或跨模块契约时必须给出回滚路径。",
            "无法回滚的变更必须升级为用户决策项。"
          ]
        }
      }
    ],
    "integrations": [
      {
        "path": "docs/integrations/issue-tracker-contract.md",
        "title": "Issue Tracker 契约",
        "sections": [
          "创建 issue",
          "同步状态",
          "交付证据"
        ],
        "content": {
          "创建 issue": [
            "issue 必须包含目标、范围、验收标准和风险。",
            "拆分后的 issue 必须能独立验证。"
          ],
          "同步状态": [
            "状态同步必须记录当前阶段、阻塞项和下一步责任角色。",
            "状态不得把未验证结果标为完成。"
          ],
          "交付证据": [
            "交付必须引用命令、日志、截图、测试结果或人工验收记录。",
            "没有证据的完成结论必须降级为待验证。"
          ]
        }
      }
    ],
    "qualityGates": [
      "requirement-gate",
      "role-activation-gate",
      "value-gate",
      "decision-gate",
      "handoff-gate",
      "complexity-gate",
      "technical-gate",
      "test-gate",
      "evidence-gate",
      "verification-gate",
      "delivery-gate"
    ],
    "rubrics": [
      "业务价值",
      "技术可行性",
      "测试可信度",
      "交付完整度"
    ]
  },
  "templates": [
    {
      "id": "prd",
      "path": "prd.md",
      "title": "PRD",
      "sections": [
        "背景与目标",
        "用户与场景",
        "范围",
        "验收标准",
        "风险"
      ],
      "content": {
        "背景与目标": [
          "写明业务背景、当前问题和预期价值。",
          "必须包含可观测成功指标。"
        ],
        "用户与场景": [
          "列出目标用户、触发场景和主路径。",
          "说明不覆盖的用户或场景。"
        ],
        "范围": [
          "明确 in scope、out of scope 和依赖。",
          "范围变更必须进入决策记录。"
        ],
        "验收标准": [
          "写成可测试或可人工验收的条件。",
          "至少覆盖核心路径和失败路径。"
        ],
        "风险": [
          "列出产品、技术、测试和交付风险。",
          "每个风险必须有缓解动作或责任角色。"
        ]
      }
    },
    {
      "id": "technical-design",
      "path": "technical-design.md",
      "title": "技术方案",
      "sections": [
        "模块边界",
        "实现计划",
        "依赖与风险",
        "回滚策略"
      ],
      "content": {
        "模块边界": [
          "列出受影响模块、接口、数据和配置。",
          "说明不进入本次需求范围的模块。"
        ],
        "实现计划": [
