{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Team Build Team Spec",
  "type": "object",
  "required": [
    "skill",
    "commands",
    "members",
    "workflows",
    "docs",
    "templates",
    "domainKnowledge",
    "capabilityMatrix",
    "acceptanceScenarios",
    "dataContracts",
    "externalSkills",
    "scripts",
    "riskControls",
    "output"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^2\\.[0-9]+\\.[0-9]+$"
    },
    "skill": {
      "type": "object",
      "required": [
        "id",
        "name",
        "description",
        "version",
        "domain",
        "targetUsers",
        "primaryValue"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/kebabId"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "targetUsers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "primaryValue": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "readme": {
      "type": "object",
      "required": [
        "english"
      ],
      "properties": {
        "english": {
          "type": "object",
          "required": [
            "name",
            "description",
            "domain",
            "primaryValue",
            "targetUsers",
            "riskDisclaimers",
            "blockedClaims"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "domain": {
              "type": "string",
              "minLength": 1
            },
            "primaryValue": {
              "type": "string",
              "minLength": 1
            },
            "targetUsers": {
              "$ref": "#/$defs/stringList"
            },
            "riskDisclaimers": {
              "$ref": "#/$defs/stringArray"
            },
            "blockedClaims": {
              "$ref": "#/$defs/stringArray"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "teamDesign": {
      "type": "object",
      "required": [
        "problemStatement",
        "mission",
        "targetOutcomes",
        "stakeholders",
        "constraints",
        "nonGoals",
        "assumptions",
        "valueMetrics"
      ],
      "properties": {
        "problemStatement": {
          "type": "string",
          "minLength": 1
        },
        "mission": {
          "type": "string",
          "minLength": 1
        },
        "targetOutcomes": {
          "$ref": "#/$defs/stringList"
        },
        "stakeholders": {
          "$ref": "#/$defs/stringList"
        },
        "constraints": {
          "$ref": "#/$defs/stringList"
        },
        "nonGoals": {
          "$ref": "#/$defs/stringList"
        },
        "assumptions": {
          "$ref": "#/$defs/stringList"
        },
        "valueMetrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "baseline",
              "target",
              "evidenceSource",
              "reviewCadence"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "baseline": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "evidenceSource": {
                "type": "string",
                "minLength": 1
              },
              "reviewCadence": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "governance": {
      "type": "object",
      "required": [
        "defaultComplexityLevel",
        "defaultExecutionProfile",
        "targetVerificationLevel",
        "roleModes",
        "reassessmentTriggers",
        "requiredGates",
        "humanReview"
      ],
      "properties": {
        "defaultComplexityLevel": {
          "type": "string",
          "enum": [
            "S",
            "M",
            "L",
            "XL"
          ]
        },
        "defaultExecutionProfile": {
          "type": "string",
          "enum": [
            "lightweight",
            "standard",
            "assurance"
          ]
        },
        "targetVerificationLevel": {
          "type": "string",
          "enum": [
            "V0",
            "V1",
            "V2",
            "V3",
            "V4"
          ]
        },
        "roleModes": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "active",
              "consulted",
              "not_applicable"
            ]
          }
        },
        "reassessmentTriggers": {
          "$ref": "#/$defs/stringList"
        },
        "requiredGates": {
          "$ref": "#/$defs/stringList"
        },
        "humanReview": {
          "type": "object",
          "required": [
            "required",
            "accountableRole",
            "requiredWhen",
            "blockedWithoutApproval"
          ],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "accountableRole": {
              "type": "string"
            },
            "requiredWhen": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "blockedWithoutApproval": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "commands": {
      "type": "object",
      "required": [
        "prefix",
        "items"
      ],
      "properties": {
        "prefix": {
          "type": "string",
          "pattern": "^/[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "workflow",
              "description",
              "requiredInput",
              "defaultOutput"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "workflow": {
                "$ref": "#/$defs/kebabId"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "requiredInput": {
                "type": "string",
                "minLength": 1
              },
              "defaultOutput": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "role",
          "when_to_load",
          "primary_outputs",
          "quality_gates",
          "responsibilities",
          "inputs",
          "outputs",
          "workingLogic",
          "checklist",
          "escalation",
          "doNotDo"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/kebabId"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "when_to_load": {
            "$ref": "#/$defs/stringList"
          },
          "primary_outputs": {
            "$ref": "#/$defs/stringList"
          },
          "quality_gates": {
            "$ref": "#/$defs/stringList"
          },
          "responsibilities": {
            "$ref": "#/$defs/stringList"
          },
          "inputs": {
            "$ref": "#/$defs/stringList"
          },
          "outputs": {
            "$ref": "#/$defs/stringList"
          },
          "workingLogic": {
            "$ref": "#/$defs/stringList"
          },
          "checklist": {
            "$ref": "#/$defs/stringList"
          },
          "escalation": {
            "$ref": "#/$defs/stringList"
          },
          "doNotDo": {
            "$ref": "#/$defs/stringList"
          },
          "activation": {
            "type": "object",
            "required": [
              "activeWhen",
              "consultedWhen",
              "notApplicableWhen",
              "reassessWhen"
            ],
            "properties": {
              "activeWhen": {
                "$ref": "#/$defs/stringList"
              },
              "consultedWhen": {
                "$ref": "#/$defs/stringList"
              },
              "notApplicableWhen": {
                "$ref": "#/$defs/stringList"
              },
              "reassessWhen": {
                "$ref": "#/$defs/stringList"
              }
            },
            "additionalProperties": false
          },
          "externalSkills": {
            "$ref": "#/$defs/stringList"
          }
        },
        "additionalProperties": false
      }
    },
    "workflows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "triggers",
          "commands",
          "members",
          "execution_mode",
          "quality_gates",
          "outputs",
          "stages"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/kebabId"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "triggers": {
            "$ref": "#/$defs/stringList"
          },
          "commands": {
            "$ref": "#/$defs/stringList"
          },
          "members": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/kebabId"
            }
          },
          "execution_mode": {
            "type": "string",
            "enum": [
              "sequential",
              "hybrid"
            ]
          },
          "quality_gates": {
            "$ref": "#/$defs/stringList"
          },
          "outputs": {
            "$ref": "#/$defs/stringList"
          },
          "stages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "name",
                "owner",
                "actions",
                "outputs",
                "gates"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "owner": {
                  "type": "string",
                  "minLength": 1
                },
                "actions": {
                  "$ref": "#/$defs/stringList"
                },
                "outputs": {
                  "$ref": "#/$defs/stringList"
                },
                "gates": {
                  "$ref": "#/$defs/stringList"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "docs": {
      "type": "object",
      "required": [
        "methodologies",
        "standards",
        "integrations",
        "qualityGates",
        "rubrics"
      ],
      "properties": {
        "methodologies": {
          "$ref": "#/$defs/docList"
        },
        "standards": {
          "$ref": "#/$defs/docList"
        },
        "integrations": {
          "$ref": "#/$defs/docList"
        },
        "qualityGates": {
          "$ref": "#/$defs/stringList"
        },
        "rubrics": {
          "$ref": "#/$defs/stringList"
        }
      },
      "additionalProperties": false
    },
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "title",
          "sections"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/kebabId"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "sections": {
            "$ref": "#/$defs/stringList"
          },
          "content": {
            "$ref": "#/$defs/contentMap"
          }
        },
        "additionalProperties": false
      }
    },
    "domainKnowledge": {
      "type": "object",
      "required": [
        "concepts",
        "methods",
        "evidenceChecklist",
        "failureModes"
      ],
      "properties": {
        "concepts": {
          "$ref": "#/$defs/stringList"
        },
        "methods": {
          "$ref": "#/$defs/stringList"
        },
        "evidenceChecklist": {
          "$ref": "#/$defs/stringList"
        },
        "failureModes": {
          "$ref": "#/$defs/stringList"
        }
      },
      "additionalProperties": false
    },
    "capabilityMatrix": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "capability",
          "owner",
          "inputs",
          "outputs",
          "gates",
          "maturity"
        ],
        "properties": {
          "capability": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "$ref": "#/$defs/kebabId"
          },
          "inputs": {
            "$ref": "#/$defs/stringList"
          },
          "outputs": {
            "$ref": "#/$defs/stringList"
          },
          "gates": {
            "$ref": "#/$defs/stringList"
          },
          "maturity": {
            "type": "string",
            "enum": [
              "draft",
              "usable",
              "validated"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "acceptanceScenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "input",
          "expectedOutputs",
          "mustPassGates",
          "failureExamples"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/kebabId"
          },
          "input": {
            "type": "string",
            "minLength": 1
          },
          "expectedOutputs": {
            "$ref": "#/$defs/safeRelativePathList"
          },
          "mustPassGates": {
            "$ref": "#/$defs/stringList"
          },
          "failureExamples": {
            "$ref": "#/$defs/stringList"
          },
          "expectedWorkflow": {
            "$ref": "#/$defs/kebabId"
          },
          "expectedProfile": {
            "type": "string",
            "enum": [
              "lightweight",
              "standard",
              "assurance"
            ]
          },
          "minimumVerificationLevel": {
            "type": "string",
            "enum": [
              "V0",
              "V1",
              "V2",
              "V3",
              "V4"
            ]
          },
          "expectedRolePlan": {
            "type": "object",
            "required": [
              "active",
              "consulted",
              "notApplicable"
            ],
            "properties": {
              "active": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/kebabId"
                },
                "uniqueItems": true
              },
              "consulted": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/kebabId"
                },
                "uniqueItems": true
              },
              "notApplicable": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/kebabId"
                },
                "uniqueItems": true
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "dataContracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source",
          "freshness",
          "requiredFields",
          "missingDataPolicy",
          "allowedUse"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "freshness": {
            "type": "string",
            "minLength": 1
          },
          "requiredFields": {
            "$ref": "#/$defs/stringList"
          },
          "missingDataPolicy": {
            "type": "string",
            "minLength": 1
          },
          "allowedUse": {
            "$ref": "#/$defs/stringList"
          }
        },
        "additionalProperties": false
      }
    },
    "externalSkills": {
      "type": "object",
      "required": [
        "skills",
        "roleMap",
        "adapters",
        "installPolicy"
      ],
      "properties": {
        "skills": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "package",
              "qualityTier",
              "roles",
              "keywords",
              "useWhen"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/kebabId"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "package": {
                "type": "string",
                "minLength": 1
              },
              "qualityTier": {
                "type": "string",
                "enum": [
                  "recommended",
                  "candidate"
                ]
              },
              "roles": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/kebabId"
                }
              },
              "keywords": {
                "$ref": "#/$defs/stringList"
              },
              "useWhen": {
                "$ref": "#/$defs/stringList"
              }
            },
            "additionalProperties": false
          }
        },
        "roleMap": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "role",
              "skills"
            ],
            "properties": {
              "role": {
                "$ref": "#/$defs/kebabId"
              },
              "skills": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/kebabId"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "adapters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "skill",
              "provider",
              "inputSchema",
              "outputSchema",
              "auth",
              "fallback",
              "verifyCommand"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/kebabId"
              },
              "skill": {
                "$ref": "#/$defs/kebabId"
              },
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "inputSchema": {
                "$ref": "#/$defs/stringList"
              },
              "outputSchema": {
                "$ref": "#/$defs/stringList"
              },
              "auth": {
                "type": "string",
                "enum": [
                  "none",
                  "user-approval",
                  "credential-required"
                ]
              },
              "fallback": {
                "type": "string",
                "minLength": 1
              },
              "verifyCommand": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "installPolicy": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "scripts": {
      "type": "object",
      "required": [
        "includeContextBuilder",
        "includeExternalSkillInstaller",
        "includeValidation"
      ],
      "properties": {
        "includeContextBuilder": {
          "type": "boolean"
        },
        "includeExternalSkillInstaller": {
          "type": "boolean"
        },
        "includeValidation": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "riskControls": {
      "type": "object",
      "required": [
        "domainRiskLevel",
        "requiredDisclaimers",
        "blockedClaims",
        "evidenceRules"
      ],
      "properties": {
        "domainRiskLevel": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "requiredDisclaimers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blockedClaims": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidenceRules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "humanReview": {
          "type": "object",
          "required": [
            "required",
            "accountableRole",
            "requiredWhen",
            "blockedWithoutApproval"
          ],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "accountableRole": {
              "type": "string"
            },
            "requiredWhen": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "blockedWithoutApproval": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": [
        "defaultDirectory",
        "overwritePolicy"
      ],
      "properties": {
        "defaultDirectory": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:(?:<skills-root>|\\$SKILLS_ROOT)/(?!(?:\\.\\.?)(?:/|$))(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._/-]+|(?!(?:\\.\\.?)(?:/|$))(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._/-]+)$"
        },
        "overwritePolicy": {
          "type": "string",
          "enum": [
            "block",
            "overwrite"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "kebabId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "safeRelativePathList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._/-]+$"
      }
    },
    "docList": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "title",
          "sections"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "sections": {
            "$ref": "#/$defs/stringList"
          },
          "content": {
            "$ref": "#/$defs/contentMap"
          }
        },
        "additionalProperties": false
      }
    },
    "contentMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/stringList"
      }
    }
  }
}
