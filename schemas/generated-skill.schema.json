{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generated Team Skill Runtime",
  "type": "object",
  "required": [
    "schemaVersion",
    "skill",
    "runtime",
    "entrypoints",
    "install",
    "agentHints"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "string"
    },
    "skill": {
      "type": "object",
      "required": [
        "id",
        "name",
        "version",
        "entry",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "entry": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "runtime": {
      "type": "object",
      "required": [
        "node",
        "packageManager",
        "requiredCommands"
      ],
      "properties": {
        "node": {
          "type": "string"
        },
        "packageManager": {
          "type": "string"
        },
        "requiredCommands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "optionalCommands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "environmentVariables": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "entrypoints": {
      "type": "object",
      "required": [
        "skill",
        "readme",
        "commands",
        "validation"
      ],
      "properties": {
        "skill": {
          "type": "string"
        },
        "readme": {
          "type": "string"
        },
        "commands": {
          "type": "string"
        },
        "validation": {
          "type": "string"
        }
      }
    },
    "install": {
      "type": "object",
      "required": [
        "packageName",
        "supportedTargets",
        "postInstall",
        "requiredFiles",
        "methods"
      ],
      "properties": {
        "packageName": {
          "type": "string"
        },
        "supportedTargets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "postInstall": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requiredFiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "methods": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "agentHints": {
      "type": "object",
      "required": [
        "readOrder",
        "executionPolicy",
        "roleActivationPolicy",
        "verificationPolicy"
      ],
      "properties": {
        "readOrder": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "environmentPolicy": {
          "type": "string"
        },
        "generationPolicy": {
          "type": "string"
        },
        "executionPolicy": {
          "type": "string"
        },
        "roleActivationPolicy": {
          "type": "string"
        },
        "verificationPolicy": {
          "type": "string"
        },
        "externalSkillPolicy": {
          "type": "string"
        }
      }
    },
    "privacy": {
      "type": "object"
    }
  }
}
